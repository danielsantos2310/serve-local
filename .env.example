# Copy to .env.local for local development. NEVER commit real values.
# Use STAGING values only in the prototype. Stripe keys must start with sk_test_ / pk_test_.

# Supabase (staging project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-side-only-never-expose

# Stripe (TEST MODE ONLY in the prototype)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email (optional; Supabase built-in email can be used instead)
RESEND_API_KEY=re_xxx
EMAIL_FROM=bookings@your-test-domain.example

# App
APP_ENV=staging
APP_BASE_URL=http://localhost:3000
PILOT_POSTCODE_PREFIXES=E8,E5   # example only: set the real pilot area
PLATFORM_FEE_PERCENT=10         # placeholder; test two levels in Phase 1
CANCELLATION_WINDOW_HOURS=24    # placeholder; see docs/09 Q2
ID_RETENTION_DAYS=90            # placeholder; confirm with solicitor (docs/07)
